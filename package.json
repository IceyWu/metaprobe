{
  "name": "metaprobe",
  "version": "0.2.1",
  "packageManager": "pnpm@12.2.1",
  "description": "Cross-platform image and video metadata extraction powered by Rust — Node.js, browser, Expo and React Native",
  "author": {
    "name": "Lev Wu",
    "email": "hi@levwu.me",
    "url": "https://github.com/IceyWu"
  },
  "homepage": "https://github.com/IceyWu/metaprobe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IceyWu/metaprobe.git"
  },
  "bugs": {
    "url": "https://github.com/IceyWu/metaprobe/issues"
  },
  "funding": "https://github.com/sponsors/IceyWu",
  "main": "native/index.js",
  "types": "native/index.d.ts",
  "react-native": "./react-native/index.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./react-native/index.ts",
        "default": "./react-native/index.ts"
      },
      "node": {
        "types": "./native/index.d.ts",
        "default": "./native/index.js"
      },
      "default": {
        "types": "./wasm/index.d.ts",
        "default": "./wasm/index.js"
      }
    },
    "./miniprogram": {
      "types": "./miniprogram/index.d.ts",
      "default": "./miniprogram/index.js"
    },
    "./miniprogram/index_bg.wasm": "./miniprogram/index_bg.wasm",
    "./react-native": {
      "types": "./react-native/index.ts",
      "default": "./react-native/index.ts"
    }
  },
  "files": [
    "native/",
    "wasm/",
    "miniprogram/",
    "android/",
    "ios/",
    "react-native/",
    "expo-module.config.json",
    "metaprobe.podspec",
    "Sources/MetaprobeSwift/",
    "Metaprobe.xcframework/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "napi": {
    "binaryName": "metaprobe",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build:napi": "napi build --output-dir native --platform --release --manifest-path crates/napi/Cargo.toml",
    "build:napi:debug": "napi build --output-dir native --platform --manifest-path crates/napi/Cargo.toml",
    "build:wasm": "wasm-pack build crates/wasm --target web --out-dir ../../wasm --out-name index && pnpm build:miniprogram",
    "build:android:arm64": "cargo ndk -t arm64-v8a -o android/src/main/jniLibs build --manifest-path crates/android-ffi/Cargo.toml --release",
    "build:miniprogram": "tsc -p tsconfig.miniprogram.json && node scripts/build-miniprogram.mjs",
    "test:miniprogram": "node --test test/miniprogram.test.mjs",
    "build": "pnpm build:napi && pnpm build:wasm",
    "benchmark": "node scripts/benchmark.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-native-version.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release": "pnpm release:check && pnpm exec changeset publish",
    "prepack": "node scripts/prepack.mjs",
    "prepublishOnly": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "expo": ">=58.0.0",
    "expo-modules-core": ">=58.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@napi-rs/cli": "^3.9.0",
    "exifr": "^7.1.3",
    "expo-modules-core": "58.0.29",
    "mediainfo.js": "^0.3.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">= 16"
  },
  "license": "MIT",
  "keywords": [
    "exif",
    "image",
    "metadata",
    "jpeg",
    "png",
    "gif",
    "bmp",
    "tiff",
    "webp",
    "ico",
    "svg",
    "jpeg2000",
    "jxl",
    "heic",
    "avif",
    "cr3",
    "mov",
    "mp4",
    "avi",
    "webm",
    "mkv",
    "flv",
    "mpeg",
    "ogg",
    "napi",
    "wasm",
    "rust",
    "native",
    "browser",
    "expo",
    "react-native"
  ]
}
